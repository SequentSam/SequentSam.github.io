---
layout: layouts/base.njk
title: Home
---
<section class="section hero">
  <div class="hero-content">
    <p class="eyebrow">{{ site.description }}</p>
    <h1>Hi, I'm Sam Alexander</h1>
    <p>Thanks for stopping by. If you’re into technology (especially the nostalgic bits), mid-80s Corvettes, long-distance running, or Russian literature, you’re in the right place.  </p>
    <a class="cta" href="/contact/">Contact me →</a>
  </div>
  <div class="hero-media">
    <img class="profile-photo" src="/assets/images/sam.png" alt="Portrait of {{ site.author }}" />
  </div>
</section>

{% set latestPosts = collections.blog | head(3) %}
<section class="section blog-preview">
  <div class="section-heading">
    <h2>Latest from my blog</h2>
    {% if collections.blog | length > 3 %}
      <a class="link-more" href="/blog/">See all posts →</a>
    {% endif %}
  </div>

  {% if latestPosts | length %}
    <div class="blog-grid{% if latestPosts | length == 1 %} blog-grid--single{% endif %}">
      {% for post in latestPosts %}
        <article class="blog-card" data-tags="{{ (post.data.tags or []) | join(',') }}">
          <a class="blog-card__image" href="{{ post.url }}">
            {% if post.data.image %}
              <img src="{{ post.data.image }}" alt="{{ post.data.title }} cover image" loading="lazy" />
            {% endif %}
          </a>
          <div class="blog-card__body">
            <p class="post-date">{{ post.date | readableDate }}</p>
            <h3><a href="{{ post.url }}">{{ post.data.title }}</a></h3>
            <p>{{ post.data.excerpt }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No blog posts published yet.</p>
  {% endif %}
</section>



