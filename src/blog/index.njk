---
layout: layouts/base.njk
title: Blog
pagination:
  data: collections.blog
  size: 10
  alias: posts
permalink: "/blog/{% if pagination.pageNumber > 0 %}page/{{ pagination.pageNumber + 1 }}/{% endif %}"
---
<section class="section">
  <div class="section-heading">
    <h1>Blog</h1>
    <p>Stories and lessons learned while building Eleventy projects.</p>
  </div>

  {% if posts | length %}
    {% set tags = collections.blog | tagList %}
    {% if tags | length %}
      <div class="tag-filter" data-tag-filter data-grid="#blog-grid">
        <span class="tag-filter__label">Filter by tag:</span>
        <div class="tag-filter__buttons">
          <button type="button" data-tag="all" aria-pressed="true">All</button>
          {% for tag in tags %}
            <button type="button" data-tag="{{ tag }}">{{ tag }}</button>
          {% endfor %}
        </div>
      </div>
    {% endif %}

    <div id="blog-grid" class="blog-grid{% if posts | length == 1 %} blog-grid--single{% endif %}">
      {% for post in posts %}
        <article class="blog-card" data-tags="{{ (post.data.tags or []) | join(',') }}">
          <a class="blog-card__image" href="{{ post.url }}">
            {% if post.data.image %}
              <img src="{{ post.data.image }}" alt="{{ post.data.title }} cover image" loading="lazy" />
            {% endif %}
          </a>
          <div class="blog-card__body">
            <p class="post-date">{{ post.date | readableDate }}</p>
            <h2><a href="{{ post.url }}">{{ post.data.title }}</a></h2>
            <p>{{ post.data.excerpt }}</p>
          </div>
        </article>
      {% endfor %}
    </div>
  {% else %}
    <p>No blog posts published yet.</p>
  {% endif %}

  <nav class="pagination" aria-label="Blog pagination">
    {% if pagination.href.previous %}
      <a class="pagination__link" href="{{ pagination.href.previous }}">← Newer posts</a>
    {% endif %}
    {% if pagination.href.next %}
      <a class="pagination__link" href="{{ pagination.href.next }}">Older posts →</a>
    {% endif %}
  </nav>
</section>
